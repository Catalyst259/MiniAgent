{
  "name": "keys_probe",
  "argv": ["./.venv/bin/python", "-m", "harness", "--mock", "--no-memory", "--no-checkpoint"],
  "cwd": "/home/catalyst259/Personal-Files/Agent",
  "env": {"DEEPSEEK_API_KEY": null, "EMBEDDING_API_KEY": null, "TERM": "xterm-256color"},
  "rows": 24,
  "cols": 100,
  "quiesce": 1.0,
  "idle_window": 1.0,
  "hard_timeout": 70.0,
  "actions": [
    {"type": "wait_for", "pattern": "\u203a"},
    {"type": "sleep", "seconds": 0.4},
    {"type": "run_turn", "text": "hi"},
    {"type": "run_turn", "text": "hi again"},
    {"type": "run_turn", "text": "one more"},
    {"type": "run_turn", "text": "last"},
    {"type": "sleep", "seconds": 0.8},
    {"type": "snapshot", "label": "bottom"},
    {"type": "send", "data": "\u001b[5~", "label": "PageUp"},
    {"type": "sleep", "seconds": 0.6},
    {"type": "snapshot", "label": "after_pageup"},
    {"type": "send", "data": "\u001b[<64;12;6M", "label": "SGR_wheel_up"},
    {"type": "sleep", "seconds": 0.6},
    {"type": "snapshot", "label": "after_wheelup"},
    {"type": "send", "data": "\u001b[<65;12;6M", "label": "SGR_wheel_down"},
    {"type": "sleep", "seconds": 0.5},
    {"type": "snapshot", "label": "after_wheeldown"},
    {"type": "send", "data": "\u001b[F", "label": "End"},
    {"type": "sleep", "seconds": 0.5},
    {"type": "snapshot", "label": "after_end"},
    {"type": "resize", "rows": 24, "cols": 60},
    {"type": "sleep", "seconds": 1.2},
    {"type": "snapshot", "label": "after_resize60"},
    {"type": "quit", "delay": 0.3}
  ]
}
