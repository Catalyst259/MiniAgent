{
  "name": "hl2_turn",
  "rows": 24,
  "cols": 100,
  "idle_window": 4.0,
  "hard_timeout": 40.0,
  "actions": [
    {"type": "wait_for", "pattern": "\u203a"},
    {"type": "sleep", "seconds": 0.5},
    {"type": "snapshot", "label": "startup"},
    {"type": "run_turn", "text": "hi"},
    {"type": "snapshot", "label": "after_turn", "delay": 0.6},
    {"type": "idle", "delay": 0.6},
    {"type": "snapshot", "label": "after_idle"},
    {"type": "quit", "delay": 0.3}
  ]
}
