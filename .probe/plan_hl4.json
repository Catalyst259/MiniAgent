{
  "name": "hl4_width60",
  "rows": 30,
  "cols": 60,
  "idle_window": 3.0,
  "hard_timeout": 40.0,
  "actions": [
    {"type": "wait_for", "pattern": "\u203a"},
    {"type": "sleep", "seconds": 0.4},
    {"type": "run_turn", "text": "hi"},
    {"type": "snapshot", "label": "A_cols60_after_turn", "delay": 1.2},
    {"type": "send", "data": "Z", "label": "type_Z"},
    {"type": "snapshot", "label": "B_after_typing_Z", "delay": 0.8},
    {"type": "send", "data": "/", "label": "slash_popup"},
    {"type": "snapshot", "label": "C_popup_visible", "delay": 0.8},
    {"type": "send", "data": "\u001b[5~", "label": "PageUp_with_popup"},
    {"type": "snapshot", "label": "D_after_pageup_popup", "delay": 0.8},
    {"type": "send", "data": "\u001b[A", "label": "Up_with_popup"},
    {"type": "snapshot", "label": "E_after_up_popup", "delay": 0.8},
    {"type": "send", "data": "\u001b[F", "label": "End"},
    {"type": "snapshot", "label": "F_after_end", "delay": 0.8},
    {"type": "send", "data": "\u001b", "label": "escape_dismiss"},
    {"type": "resize", "rows": 30, "cols": 100, "label": "resize100"},
    {"type": "snapshot", "label": "G_after_resize100", "delay": 1.5},
    {"type": "quit", "delay": 0.3}
  ]
}
